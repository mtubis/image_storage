server {
    listen 80;
    server_name _;
    root /var/www/html/public;
    index index.php index.html;
    # No nginx version in the Server header or error pages, like expose_php = Off for PHP.
    server_tokens off;

    # Matches php.ini's upload_max_filesize/post_max_size (docker/php/php.ini)
    # so an oversized upload gets Laravel's 422, not nginx's bare 413.
    client_max_body_size 10M;

    # A body over that limit never reaches Laravel. nginx's default 413 is HTML without CORS
    # headers, which the SPA can only see as a network error; answer like Laravel instead.
    error_page 413 @payload_too_large;

    location @payload_too_large {
        default_type application/json;
        add_header Access-Control-Allow-Origin "${FRONTEND_URL}" always;
        return 413 '{"message":"The POST data is too large."}';
    }

    # Infra healthcheck endpoint, independent of the app, so nginx reports
    # healthy even while PHP is unavailable.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Generated WebP thumbnails. Names are ULIDs and never rewritten, so they can be cached
    # for good; nosniff because the files are user-derived.
    location /storage/thumbnails/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        # A literal host is resolved once at startup, so a recreated php container (new IP)
        # would get 502 until nginx restarts. Through a variable nginx asks Docker's embedded
        # DNS again once the answer expires. 127.0.0.11 exists only on Docker networks.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $php_upstream php:9000;
        fastcgi_pass $php_upstream;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
