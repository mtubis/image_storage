# Backend (Laravel) — storage/ and bootstrap/cache/ are already handled by
# Laravel's own nested .gitignore files; only cross-cutting paths go here.
# Pure PHP API, no npm/vite usage, so no /backend/node_modules entry.
/backend/vendor
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/public/storage
/backend/.phpunit.cache

# Frontend (Vite/React)
/frontend/node_modules
/frontend/dist
/frontend/coverage
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# E2E (Playwright)
/e2e/node_modules
/e2e/test-results
/e2e/playwright-report

# Local AI-assistant configuration and working notes; not part of the repository
/CLAUDE.md
/PLAN.md
/.claude*

# Editors / OS
.DS_Store
*.log
.idea
.vscode
